/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# CSS/JS 沒有 hash 檔名；build 會加內容指紋 query，這裡仍要求重新驗證。
# 即使 zone 的 Browser Cache TTL 覆寫本規則，新的指紋也會形成新 URL。
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 課程資料改版要立刻反映；app 也會帶與前端相同的內容指紋 query。
/course.json
  Cache-Control: public, max-age=0, must-revalidate

# max-age=0 + must-revalidate 正常情況仍走 ETag，命中時只回 304。
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# 圖與爬蟲檔改動少，可以放長
/og.png
  Cache-Control: public, max-age=2592000

/llms.txt
  Cache-Control: public, max-age=86400

# 計數 API 不能被任何一層快取，否則數字會凍在某個值
/api/*
  Cache-Control: no-store, max-age=0
