course/data/syllabus.json  linguist-generated=true
course/data/oe-*.json      linguist-generated=true
course/data/drill-evidence-*.json linguist-generated=true
course/data/alt-lessons-*.json    linguist-generated=true

* text=auto eol=lf
*.png binary
src/web/og.png linguist-generated=true -diff
